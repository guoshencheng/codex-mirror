# Vercel Web/API connection: use the managed Postgres serverless/pooler URL.
APP_ORIGIN=https://status.example.com
DATABASE_URL=postgresql://user:password@pooler.example.com:6543/database?sslmode=require

# Remote Provider Runtime, migration and administration commands: use the direct URL.
DATABASE_DIRECT_URL=postgresql://user:password@database.example.com:5432/database?sslmode=require

# Exact CLI versions installed in the remote provider-runtime image.
CODEX_CLI_VERSION=0.146.0
KIMI_CODE_VERSION=2.0.2
